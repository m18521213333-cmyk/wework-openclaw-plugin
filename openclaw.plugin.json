{
  "id": "wework-scrm",
  "name": "WeWork SCRM",
  "description": "企业微信 SCRM 插件 — 通过 Java 后端 WS 协议操控，与 Web 管理端共存",
  "version": "0.2.0",
  "author": "zhijiansmart",
  "enabledByDefault": true,
  "activation": {
    "onStartup": true
  },
  "channels": ["wework"],
  "channelConfigs": {
    "wework": {
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string" },
          "enabled": { "type": "boolean" },
          "javaWsUrl": { "type": "string", "default": "ws://127.0.0.1:15088" }
        }
      }
    }
  },
  "contracts": {
    "tools": [
      "wework_accept_friend",
      "wework_add_customer_by_id",
      "wework_add_customer_search",
      "wework_add_customer_wx",
      "wework_chatroom_action",
      "wework_create_label",
      "wework_delete_customer",
      "wework_delete_label",
      "wework_delete_moments",
      "wework_delete_sns_comment",
      "wework_download_file",
      "wework_forward_message",
      "wework_get_contact",
      "wework_get_ext_user_id",
      "wework_get_group_members",
      "wework_get_history",
      "wework_get_moments_tasks",
      "wework_get_my_moments",
      "wework_get_qrcode",
      "wework_get_sns_detail",
      "wework_list_devices",
      "wework_mass_send",
      "wework_modify_label",
      "wework_phone_status",
      "wework_post_moments",
      "wework_post_moments_task",
      "wework_revoke_message",
      "wework_search_messages",
      "wework_send_friend_verify",
      "wework_send_message",
      "wework_set_memo",
      "wework_set_user_labels",
      "wework_sns_comment",
      "wework_sns_like",
      "wework_sync_data",
      "wework_sync_labels"
    ]
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "javaWsUrl": {
        "type": "string",
        "default": "ws://127.0.0.1:15088",
        "description": "Java 后端 WebSocket 地址 (PC端协议端口)"
      },
      "auth": {
        "type": "object",
        "description": "认证 — 必须配, 否则 Java 后端不会向插件推送业务消息 (msgSend2pc 只对认证连接广播)",
        "properties": {
          "authType": {
            "type": "integer",
            "enum": [2, 3],
            "default": 2,
            "description": "2=Username (账号密码), 3=InternalCode (走IP白名单)"
          },
          "username": {
            "type": "string",
            "description": "PC端账号 (service 用, 跟 CLI 必须用不同账号否则互踢)"
          },
          "password": {
            "type": "string",
            "description": "PC端密码"
          },
          "cliUsername": {
            "type": "string",
            "description": "CLI 命令专用账号 (跟 service 隔离避免 squeeze)"
          },
          "cliPassword": {
            "type": "string",
            "description": "CLI 账号密码"
          }
        }
      },
      "storage": {
        "type": "object",
        "description": "本地数据存储配置",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["sqlite", "mysql"],
            "default": "sqlite",
            "description": "存储类型"
          },
          "sqlitePath": {
            "type": "string",
            "default": "./wework-scrm.db",
            "description": "SQLite 数据库路径"
          }
        }
      },
      "dify": {
        "type": "object",
        "description": "Dify AI 集成配置（可选）",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "apiUrl": {
            "type": "string",
            "description": "Dify API 地址"
          },
          "apiKey": {
            "type": "string",
            "description": "Dify API Key"
          }
        }
      }
    },
    "required": []
  }
}
